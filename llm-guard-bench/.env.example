# LLM Guard Bench - Environment Configuration Template
# =========================================================================
# IMPORTANT: This is a TEMPLATE ONLY - NO SECRETS SHOULD BE PRESENT HERE
#
# Instructions:
# 1. Copy to .env: cp .env.example .env
# 2. Fill in your actual API keys and endpoints in .env
# 3. .env is GITIGNORED and will NEVER be committed to version control
# 4. Verify with: git check-ignore -v .env
# =========================================================================

# =========================================================================
# MODEL PROVIDER SELECTION
# =========================================================================
# Target Model Provider: which service runs the target model
# Options: ollama (local), groq (API), openai (API), anthropic (API)
TARGET_PROVIDER=ollama

# Judge Model Provider: which service evaluates the target responses
# Options: groq (recommended), openai, anthropic
JUDGE_PROVIDER=groq
JUDGE_MODEL_NAME=openai/gpt-oss-20b

# =========================================================================
# API KEYS - KEEP THESE SECRET AND OUT OF VERSION CONTROL
# =========================================================================
# Groq API Key (required if JUDGE_PROVIDER=groq)
# Get your free key from: https://console.groq.com/keys
# DO NOT commit this file with a real key - use placeholder like below
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (optional, for OpenAI models)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (optional, for Claude models)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =========================================================================
# LOCAL INFRASTRUCTURE ENDPOINTS
# =========================================================================
# Ollama Service Endpoint (local or remote)
# Local development: http://localhost:11434
# Docker Compose: http://ollama:11434
# Docker from host: http://host.docker.internal:11434
OLLAMA_ENDPOINT=http://localhost:11434

# Alternative Ollama URL for Docker environments
OLLAMA_BASE_URL=http://host.docker.internal:11434

# =========================================================================
# DATABASE CONFIGURATION
# =========================================================================
# SQLite database file path (relative to project root)
DB_PATH=results/guard_bench.db

# =========================================================================
# LOGGING & DEBUG SETTINGS
# =========================================================================
# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Use DEBUG only for development/troubleshooting
LOG_LEVEL=INFO

# =========================================================================
# TIMEOUT & CONCURRENCY SETTINGS
# =========================================================================
# Request Timeout in seconds (for API calls)
REQUEST_TIMEOUT=180

# Maximum concurrent benchmark executions
# Use 1 for GPUs with less than 6GB VRAM.
CONCURRENCY_LIMIT=1
