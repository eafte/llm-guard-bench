.ropeproject/
.pytest_cache/
.coverage
htmlcov/

# ============================================================================
# SECURITY: ENVIRONMENT & CREDENTIALS (CRITICAL)
# ============================================================================
.env
.env.local
.env.*.local
.env.*.example
.env.production
.env.staging
.env.development
secrets/
*.key
*.pem
*.pfx
*.p12
.aws/
.azure/

# ============================================================================
