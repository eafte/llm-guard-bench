*.swp
*.swa
*~
.netrwhist
Session.vim
.vim/
.LSP/

# ============================================================================
# GIT CONFIGURATION
# ============================================================================
.git/
.gitattributes
.gitignore_local

# ============================================================================
# IMPORTANT: DO NOT IGNORE THESE ESSENTIAL FILES
# ============================================================================
# Ensure the following are tracked in git:
# !.env.example
# !setup.py
# !requirements.txt
# !README.md
# !LICENSE
# !Dockerfile
# !docker-compose.yml
# !.github/
# !/config/prompts.json
.env
results/*.db
results/*.png
